# Frozen prompts are hashed byte for byte (manifest sha256): never convert their line endings.
bench/prompts/** -text

# Curated runtime evidence retains original whitespace/CRLF and byte hashes.
bench/results/2026-10-10-safetensors-runtime/p15-prefill-first/runtime/** -text -whitespace
bench/results/2026-10-10-safetensors-runtime/p16-speed-tuning/** -text -whitespace

# launchers keep their platform line endings wherever the repository is cloned
*.sh text eol=lf
*.bat text eol=crlf

# copies of real packs' native_experts.txt, parsed byte for byte by tests/core/expert_layout_test.cpp
tests/data/native_experts/** -text
release/windows/*.cmd text eol=crlf
release/*.cmd text eol=crlf
